{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Unhollowed window: host lifecycle commands, the Swish module's own commands, and event listening so modules can hear their close request. No filesystem, shell or network access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-host-module-activated",
    "allow-host-module-deactivated",
    "allow-host-power-off",
    "allow-selftest-enabled",
    "allow-selftest-report",
    "allow-selftest-resize",
    "allow-selftest-finish",
    "swish:allow-load-workspace",
    "swish:allow-create-project",
    "swish:allow-update-project",
    "swish:allow-create-reminder",
    "swish:allow-update-reminder",
    "swish:allow-set-reminder-completed",
    "swish:allow-delete-project",
    "swish:allow-delete-reminder",
    "swish:allow-restore-reminder",
    "swish:allow-export-backup",
    "swish:allow-inspect-backup",
    "swish:allow-cancel-restore",
    "swish:allow-restore-backup",
    "swish:allow-undo-restore",
    "swish:allow-finish-exit",
    "terminal:allow-journal-list",
    "terminal:allow-journal-last",
    "terminal:allow-journal-select",
    "terminal:allow-journal-save",
    "terminal:allow-journal-delete",
    "terminal:allow-journal-finish-exit",
    "terminal:allow-preferences-get",
    "terminal:allow-preferences-set",
    "terminal:allow-backup-export",
    "terminal:allow-backup-choose",
    "terminal:allow-backup-restore",
    "terminal:allow-backup-cancel",
    "terminal:allow-entry-export",
    "ember:allow-practice-days",
    "ember:allow-website-snapshot",
    "ember:allow-export-history",
    "ember:allow-restore-history",
    "ember:allow-habits-list",
    "ember:allow-habits-create",
    "ember:allow-habits-rename",
    "ember:allow-habits-move",
    "ember:allow-habits-archive",
    "ember:allow-habits-delete-preview",
    "ember:allow-habits-delete-archived",
    "ember:allow-completions-month",
    "ember:allow-completions-toggle",
    "ember:allow-finish-exit",
    "ember:allow-play-startup-sound",
    "ember:allow-sound-preferences-set",
    "ember:allow-startup-sound-native",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
